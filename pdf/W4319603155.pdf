<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>What is the heliopause? Importance of magnetic reconnection and measurement requirements</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>B. Lavraud</rdf:li>
<rdf:li>M. Opher</rdf:li>
<rdf:li>K. Dialynas</rdf:li>
<rdf:li>D. L. Turner</rdf:li>
